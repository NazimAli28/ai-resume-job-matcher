// Spec: docs/prd/04-architecture.md §4. Models arrive phase by phase (Phase 1 identity/platform, Phase 2 profile, Phase 3 resumes).
// Every table gets RLS enabled with no policies (deny-all for anon/authenticated) in its migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────
enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  SPRINT
}

enum TaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum TaskType {
  RESUME_PARSE
  RESUME_ANALYZE
  JOB_EXTRACT
  MATCH_COMPUTE
  RESUME_TAILOR
  EXPORT_RENDER
  INTERVIEW_EVALUATE
  COVERLETTER_GENERATE
  REMINDERS_DISPATCH
  REMINDER_SEND
  RETENTION_INACTIVITY
  RETENTION_INTERVIEW_ANSWERS
  PRIVACY_EXPORT
  ACCOUNT_DELETE
  ACCOUNT_DELETE_FINALIZE
  STORAGE_SWEEP
  EXPORT_PURGE
  PRIVACY_EXPORT_EXPIRE
  OPS_COST_REPORT
  INTERVIEW_CLOSE_ABANDONED
  ERROR_DIGEST
  DB_HOUSEKEEPING
}

enum ErrorSource {
  ROUTE
  ACTION
  TASK
  RENDER
  CLIENT
}

enum TargetMarket {
  PK_LOCAL
  INTERNATIONAL
}

/// Where a confirmed fact came from. USER = typed by the user; MATCH_QUESTION = answered a "do you have this skill?" question.
enum FactSource {
  USER
  MATCH_QUESTION
  RESUME
  INTERVIEW
}

enum FileKind {
  PDF
  DOCX
}

enum UploadStatus {
  PENDING
  UPLOADED
  PARSED
  REJECTED
  FAILED
}

enum ResumeVersionSource {
  UPLOAD
  MANUAL
  TAILORED
  SUGGESTIONS_APPLIED
  DUPLICATE
}

enum ResumeVersionState {
  DRAFT
  LOCKED
  ARCHIVED
}

enum ConsentType {
  TERMS
  PRIVACY
  AGE_16_PLUS
  SENSITIVE_DATA
  AI_PROCESSING
  TRAINING_OPT_IN
  MARKETING_EMAIL
  ANALYTICS_COOKIES
  SUPPORT_ACCESS
  EU_WITHDRAWAL_WAIVER
}

// ───────────────────────────── Identity ─────────────────────────────
/// id = Supabase auth.users.id. Credentials and sessions live in Supabase's auth schema (not modeled).
model User {
  id            String    @id
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  isBetaUser    Boolean   @default(true)
  blockedAt     DateTime?
  lastSeenAt    DateTime  @default(now())
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  consents ConsentRecord[]
  tasks    BackgroundTask[]
  profile  Profile?
  uploads  ResumeUpload[]
  versions ResumeVersion[]
  jobs     Job[]

  @@index([lastSeenAt])
  @@index([deletedAt])
}

/// Append-only; the latest row per (userId, type) wins.
model ConsentRecord {
  id         String      @id @default(uuid(7))
  userId     String
  type       ConsentType
  granted    Boolean
  docVersion String
  ipPrefix   String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

// ───────────────────────────── Platform ─────────────────────────────
/// In-house queue. payload holds IDs and enums only, never user text.
model BackgroundTask {
  id             String     @id @default(uuid(7))
  userId         String?
  type           TaskType
  payload        Json
  status         TaskStatus @default(QUEUED)
  stage          String?
  attempts       Int        @default(0)
  maxAttempts    Int        @default(5)
  runAt          DateTime   @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  idempotencyKey String     @unique
  parentId       String?
  resultRef      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  startedAt      DateTime?
  finishedAt     DateTime?
  user           User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, runAt])
  @@index([userId, status])
  @@index([type, status, createdAt])
}

/// Grouped error log. Messages are scrubbed of PII; users appear only as an HMAC.
model ErrorEvent {
  id          String      @id @default(uuid(7))
  fingerprint String      @unique
  createdAt   DateTime    @default(now())
  lastSeenAt  DateTime    @default(now())
  count       Int         @default(1)
  source      ErrorSource
  route       String?
  taskType    TaskType?
  errorClass  String
  message     String
  stack       String?
  requestId   String?
  userIdHash  String?
  release     String?
  digestedAt  DateTime?
  resolvedAt  DateTime?

  @@index([lastSeenAt])
  @@index([createdAt])
}

model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}

model AuditLog {
  id            String   @id @default(uuid(7))
  actorId       String?
  subjectUserId String?
  action        String
  ipPrefix      String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([subjectUserId, createdAt])
  @@index([action, createdAt])
}

/// Re-applied after any backup restore so deleted accounts stay deleted.
model DeletionLedger {
  id         String   @id @default(uuid(7))
  emailHash  String
  userIdHash String
  deletedAt  DateTime @default(now())

  @@index([emailHash])
}

/// Admin-editable key/value settings (e.g. default accent color).
model AppSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ───────────────────────────── Profile (Phase 2) ─────────────────────────────
/// One per user. CNIC is never stored. DOB and father's name are optional PK conventions,
/// never sent to AI, and dropped from exports for INTERNATIONAL targets.
model Profile {
  id                       String       @id @default(uuid(7))
  userId                   String       @unique
  targetMarket             TargetMarket @default(PK_LOCAL)
  headline                 String?
  targetTitles             String[]
  city                     String?
  country                  String?      @default("PK")
  phone                    String?
  linkedinUrl              String?
  githubUrl                String?
  portfolioUrl             String?
  yearsExperience          Int?
  includePhoto             Boolean      @default(false)
  dateOfBirth              DateTime?    @db.Date
  fatherName               String?
  deleteOriginalAfterParse Boolean      @default(false)
  onboardedAt              DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  user                     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills                   Skill[]
  experiences              Experience[]
  educations               Education[]
  projects                 Project[]
  certifications           Certification[]
  facts                    FactBankItem[]
}

model Skill {
  id          String   @id @default(uuid(7))
  userId      String
  profileId   String
  name        String
  canonicalId String?
  /// 1–5 self-rating. 1–2 = learning: counts as PARTIAL in matching (founder decision 2026-10-30).
  level       Int?
  years       Float?
  createdAt   DateTime @default(now())
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([userId, canonicalId])
}

model Experience {
  id        String    @id @default(uuid(7))
  userId    String
  profileId String
  title     String
  employer  String
  location  String?
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  bullets   String[]
  sortOrder Int       @default(0)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  facts     FactBankItem[]

  @@index([userId])
}

model Education {
  id          String    @id @default(uuid(7))
  userId      String
  profileId   String
  institution String
  degree      String?
  field       String?
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  grade       String?
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          String   @id @default(uuid(7))
  userId      String
  profileId   String
  name        String
  url         String?
  description String?
  bullets     String[]
  skills      String[]
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Certification {
  id            String    @id @default(uuid(7))
  userId        String
  profileId     String
  name          String
  issuer        String?
  issuedAt      DateTime? @db.Date
  expiresAt     DateTime? @db.Date
  credentialUrl String?
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Evidence bank: facts the user confirmed. Only confirmed facts may be used in suggestions.
/// skillName links a fact to a skill ("I used Docker for local dev at Kinara").
model FactBankItem {
  id           String      @id @default(uuid(7))
  userId       String
  profileId    String
  statement    String
  metric       String?
  skillName    String?
  experienceId String?
  source       FactSource  @default(USER)
  sourceRef    Json?
  confirmedAt  DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  profile      Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  experience   Experience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, skillName])
}

// ───────────────────────────── Resumes (Phase 3) ─────────────────────────────
/// A file the user uploaded. Stored in the private "resumes" bucket at storageKey; originalName is display-only.
model ResumeUpload {
  id           String        @id @default(uuid(7))
  userId       String
  storageKey   String        @unique
  originalName String
  kind         FileKind?
  sizeBytes    Int
  sha256       String?
  pageCount    Int?
  status       UploadStatus  @default(PENDING)
  rejectReason String?
  /// What a simple parser likely sees, ≤ 30k chars. Deleted with the account.
  atsText      String?
  /// Original file removed from storage (user setting or after rejection).
  fileDeletedAt DateTime?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions     ResumeVersion[]

  @@index([userId, createdAt])
}

/// An immutable-once-locked resume. content = ResumeDoc (src/server/resume/types.ts).
model ResumeVersion {
  id            String              @id @default(uuid(7))
  userId        String
  uploadId      String?
  parentId      String?
  jobId         String?
  label         String
  name          String
  source        ResumeVersionSource
  state         ResumeVersionState  @default(DRAFT)
  targetMarket  TargetMarket
  schemaVersion Int                 @default(1)
  content       Json
  contentHash   String
  lockedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime            @default(now())
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  upload        ResumeUpload?       @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  parent        ResumeVersion?      @relation("Lineage", fields: [parentId], references: [id], onDelete: SetNull)
  children      ResumeVersion[]     @relation("Lineage")
  analyses      ResumeAnalysis[]
  matches       JobMatch[]

  @@index([userId, createdAt])
}

/// Deterministic analysis of a version (Phase 4 may add AI notes; they never change the numbers).
model ResumeAnalysis {
  id              String        @id @default(uuid(7))
  userId          String
  resumeVersionId String
  parseHealth     Int
  readability     Int
  parts           Json
  findings        Json
  engineVersion   String
  createdAt       DateTime      @default(now())
  resumeVersion   ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@index([userId, resumeVersionId])
}

// ───────────────────────────── Jobs + Match (Phase 4) ─────────────────────────────
enum JobSource {
  LINKEDIN
  ROZEE_PK
  INDEED
  MUSTAKBIL
  COMPANY_SITE
  REFERRAL
  GOVT_PORTAL
  JOB_FAIR
  RECRUITER
  SOCIAL_MEDIA
  OTHER
}

enum RequirementType {
  MUST_HAVE
  NICE_TO_HAVE
}

enum RequirementKind {
  SKILL
  TOOL
  TITLE
  YEARS
  EDUCATION
  CERT
  LOCATION
  WORK_AUTH
  LANGUAGE
  SOFT
  OTHER
}

enum MatchOverride {
  CONFIRM
  REJECT
  LEARNING
  ADD_EVIDENCE
}

enum AiRequestStatus {
  OK
  INVALID_OUTPUT
  REFUSED
  ERROR
}

/// A pasted job post. rawText is an immutable snapshot; the URL is stored as a link and never fetched.
model Job {
  id               String           @id @default(uuid(7))
  userId           String
  title            String
  company          String?
  location         String?
  workMode         String?
  seniorityHint    String?
  url              String?
  source           JobSource        @default(OTHER)
  sourceDetail     String?
  rawText          String
  textHash         String
  responsibilities String[]
  /// The post contained text addressed to an AI. Treated as data, shown to the user as a notice.
  injectionSuspect Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements     JobRequirement[]
  matches          JobMatch[]

  @@index([userId, createdAt])
  @@index([userId, textHash])
}

model JobRequirement {
  id           String          @id @default(uuid(7))
  userId       String
  jobId        String
  text         String
  /// Verbatim from the post; null only when the user added the requirement.
  quote        String?
  kind         RequirementKind
  priority     RequirementType
  /// A knockout: missing it caps the score.
  hard         Boolean         @default(false)
  /// Short term to look for ("Docker"); normalized against the skill dictionary in code.
  skillTerm    String?
  years        Int?
  degreeLevel  String?
  userEdited   Boolean         @default(false)
  override     MatchOverride?
  overrideAt   DateTime?
  sortOrder    Int             @default(0)
  job          Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobId, sortOrder])
}

/// One computed result; the last 5 per job and resume are kept to show the change. items is the per-requirement snapshot.
model JobMatch {
  id              String        @id @default(uuid(7))
  userId          String
  jobId           String
  resumeVersionId String
  score           Int
  factors         Json
  items           Json
  cap             Int?
  lowConfidence   Boolean       @default(false)
  engineVersion   String
  inputsHash      String
  createdAt       DateTime      @default(now())
  job             Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeVersion   ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@index([userId, jobId, createdAt])
}

/// Metadata for every AI call. Never prompt or response text. Backs the spend guards.
model AiRequest {
  id            String          @id @default(uuid(7))
  userId        String?
  task          String
  promptVersion String
  model         String
  inTok         Int             @default(0)
  outTok        Int             @default(0)
  cachedTok     Int             @default(0)
  costUsd       Float           @default(0)
  latencyMs     Int             @default(0)
  status        AiRequestStatus
  createdAt     DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}
